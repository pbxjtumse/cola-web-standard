@startuml
[*] --> VALIDATE
VALIDATE --> BEGIN
BEGIN --> EXECUTE
EXECUTE --> COMMIT : callback normal
EXECUTE --> ROLLBACK : callback exception
COMMIT --> COMPLETED : normal completion
COMMIT --> COMMIT_UNKNOWN : infrastructure failure
COMMIT --> ROLLED_BACK : UnexpectedRollbackException
ROLLBACK --> BUSINESS_FAILED : rollback success, rethrow business error
ROLLBACK --> BUSINESS_FAILED : rollback failure kept as suppressed
COMPLETED --> [*]
COMMIT_UNKNOWN --> [*]
ROLLED_BACK --> [*]
BUSINESS_FAILED --> [*]
@enduml
