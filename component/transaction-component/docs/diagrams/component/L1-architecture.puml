@startuml
skinparam componentStyle rectangle

[Business Service] --> [TransactionExecutor]
[TransactionExecutor] --> [DefaultTransactionExecutor]
[DefaultTransactionExecutor] --> [TransactionProvider]
[TransactionProvider] --> [SpringTransactionProvider]
[SpringTransactionProvider] --> [PlatformTransactionManager]
[PlatformTransactionManager] --> [MyBatis/JDBC]
[PlatformTransactionManager] --> [JPA/Hibernate]
[MyBatis/JDBC] --> [Database]
[JPA/Hibernate] --> [Database]

note right of [TransactionExecutor]
  Explicit local transaction API
  REQUIRED / REQUIRES_NEW / MANDATORY
end note

note right of [SpringTransactionProvider]
  Spring owns propagation,
  suspend/resume, commit/rollback
end note
@enduml
