@startuml
!include ../../_common/style.puml

title Redisson Native Fencing Scenario - Provider Capability
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "LockHandleFactory" as Factory
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
participant "LockProviderCapabilities" as Capabilities
end box

box "distributed-lock-provider-redisson" #FFE6CC
participant "RedissonLockProvider" as RedissonProvider
end box

database Redis

Caller -> Client : tryLock(fencingRequired=true)
Client -> DefaultClient : delegate
DefaultClient -> Template : tryLock()
Template -> Acquire : acquire()
Acquire -> LockProvider : capabilities()
LockProvider -> RedissonProvider : capabilities()
RedissonProvider --> LockProvider : fencingTokenSupported=true
LockProvider --> Acquire : Capabilities
Acquire -> LockProvider : acquire(request)
LockProvider -> RedissonProvider : acquire(request)
RedissonProvider -> Redis : acquire native lock/token
Redis --> RedissonProvider : lock + native token
RedissonProvider --> LockProvider : ACQUIRED lease with token
LockProvider --> Acquire : lease
Acquire -> Factory : create(lease)
Factory --> Acquire : LockHandle
Acquire --> Template : LockResult(ACQUIRED)
Template --> DefaultClient : result
DefaultClient --> Client : result
Client --> Caller : result

@enduml
