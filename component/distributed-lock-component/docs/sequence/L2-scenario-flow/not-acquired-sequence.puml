@startuml
!include ../../_common/style.puml

title Not Acquired Scenario - No Lock Handle Returned
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "LockWaiter" as Waiter
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Caller -> Client : tryLock()
Client -> DefaultClient : delegate
DefaultClient -> Template : tryLock()
Template -> Acquire : acquire()
Acquire -> LockProvider : acquire(request)
LockProvider -> RedisProvider : acquire(request)
RedisProvider -> Redis : Lua acquire
Redis --> RedisProvider : lock already held
RedisProvider --> LockProvider : NOT_ACQUIRED
LockProvider --> Acquire : NOT_ACQUIRED

alt wait strategy allows retry
  Acquire -> Waiter : waitBeforeRetry(context)
  Waiter --> Acquire : continue / timeout
else no wait
  Acquire --> Template : LockResult(NOT_ACQUIRED)
end

Template --> DefaultClient : LockResult(NOT_ACQUIRED)
DefaultClient --> Client : LockResult(NOT_ACQUIRED)
Client --> Caller : not acquired

@enduml
