@startuml
!include ../../_common/style.puml

title Lock Lost Scenario - Renew Detects Lost Ownership
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "ScheduledLockWatchdog" as Watchdog
participant "DefaultLockHandle" as Handle
participant "LockRuntimeState" as RuntimeState
participant "LockEventPublisher" as Events
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Watchdog -> Handle : renew()
Handle -> LockProvider : renew(request)
LockProvider -> RedisProvider : renew(request)
RedisProvider -> Redis : Lua renew(ownerToken)
Redis --> RedisProvider : not owner / not found
RedisProvider --> LockProvider : NOT_OWNER / NOT_FOUND
LockProvider --> Handle : lost
Handle -> RuntimeState : markLost()
Handle -> Events : publish LOCK_LOST
Handle --> Watchdog : lock lost
Watchdog -> Watchdog : stop(handle)

@enduml
