@startuml
!include ../../_common/style.puml

title Provider Error Scenario - Acquire Stage
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "LockMetricsFacade" as Metrics
participant "LockEventPublisher" as Events
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Caller -> Client : tryLock/execute()
Client -> DefaultClient : delegate
DefaultClient -> Template : execute()
Template -> Acquire : acquire()
Acquire -> LockProvider : acquire(request)
LockProvider -> RedisProvider : acquire(request)
RedisProvider -> Redis : Lua acquire / Redis command
Redis --> RedisProvider : timeout / connection error
RedisProvider --> LockProvider : LockAcquireResponse(PROVIDER_ERROR)
LockProvider --> Acquire : PROVIDER_ERROR
Acquire -> Metrics : recordAcquire(success=false)
Acquire -> Events : publish PROVIDER_ERROR
Acquire --> Template : LockResult(PROVIDER_ERROR, ACQUIRE)
Template --> DefaultClient : result
DefaultClient --> Client : result
Client --> Caller : provider error

@enduml
