@startuml
!include ../../_common/style.puml

title Fencing Rejected Scenario - Business Resource Rejects Old Token
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
participant "FencingTokenGuard" as Guard
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "DefaultLockHandle" as Handle
participant "LockEventPublisher" as Events
end box

box "Business Resource" #EEEEEE
participant "Repository" as Repository
database "BusinessDB" as DB
end box

Caller -> Client : execute()
Client -> DefaultClient : delegate
DefaultClient -> Template : execute()
Template -> Handle : getFencingToken()
Handle --> Template : token=N
Template -> Repository : update(command, token=N)
Repository -> Guard : check(currentToken, requestToken)
Guard --> Repository : rejected
Repository -> DB : no update / conditional update affected 0 rows
DB --> Repository : rejected
Repository --> Template : FencingTokenRejectedException
Template -> Events : publish FENCING_REJECTED
Template --> DefaultClient : LockResult(FENCING_REJECTED)
DefaultClient --> Client : result
Client --> Caller : rejected

@enduml
