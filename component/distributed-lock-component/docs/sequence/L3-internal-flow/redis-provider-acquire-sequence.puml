@startuml
!include ../../_common/style.puml

title RedisLockProvider Acquire Internal Flow
autonumber
skinparam shadowing false

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as Provider
participant "RedisLockKeyBuilder" as KeyBuilder
participant "RedisLockScriptExecutor" as ScriptExecutor
end box

database Redis

Provider -> KeyBuilder : buildLockKey(namespace, lockName)
KeyBuilder --> Provider : lockKey
Provider -> ScriptExecutor : executeAcquire(lockKey, ownerToken, leaseTime)
ScriptExecutor -> Redis : EVAL acquire.lua
Redis --> ScriptExecutor : 1 / 0
ScriptExecutor --> Provider : raw result
alt acquired
  Provider --> Provider : build LockAcquireResponse(ACQUIRED, lease)
else not acquired
  Provider --> Provider : build LockAcquireResponse(NOT_ACQUIRED)
end

@enduml
