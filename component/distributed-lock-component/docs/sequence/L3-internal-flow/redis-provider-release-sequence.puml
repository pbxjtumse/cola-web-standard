@startuml
!include ../../_common/style.puml

title RedisLockProvider Release Internal Flow
autonumber
skinparam shadowing false

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as Provider
participant "RedisLockScriptExecutor" as ScriptExecutor
end box

database Redis

Provider -> ScriptExecutor : executeRelease(lockKey, ownerToken)
ScriptExecutor -> Redis : EVAL release.lua
Redis --> ScriptExecutor : released / not owner / not found
ScriptExecutor --> Provider : raw result
alt released
  Provider --> Provider : LockReleaseResponse(RELEASED)
else not owner / not found
  Provider --> Provider : LockReleaseResponse(NOT_OWNER or NOT_FOUND)
else error
  Provider --> Provider : LockReleaseResponse(PROVIDER_ERROR)
end

@enduml
