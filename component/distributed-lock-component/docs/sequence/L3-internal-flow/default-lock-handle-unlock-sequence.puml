@startuml
!include ../../_common/style.puml

title DefaultLockHandle Unlock Internal Flow
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "DefaultLockHandle" as Handle
participant "LockRuntimeState" as RuntimeState
participant "LockEventPublisher" as Events
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Handle -> RuntimeState : compareAndMarkReleasing()
alt already released
  RuntimeState --> Handle : skip
else first release
  Handle -> LockProvider : release(request)
  LockProvider -> RedisProvider : release(request)
  RedisProvider -> Redis : Lua release(ownerToken)
  Redis --> RedisProvider : released / not owner / not found / error
  RedisProvider --> LockProvider : LockReleaseResponse
  LockProvider --> Handle : release result
  alt RELEASED
    Handle -> RuntimeState : markReleased()
    Handle -> Events : RELEASED
  else NOT_OWNER / NOT_FOUND
    Handle -> RuntimeState : markLost()
    Handle -> Events : LOCK_LOST(stage=RELEASE)
  else PROVIDER_ERROR
    Handle -> Events : RELEASE_FAILED
  end
end

@enduml
