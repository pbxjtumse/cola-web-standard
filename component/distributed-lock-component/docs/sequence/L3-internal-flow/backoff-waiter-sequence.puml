@startuml
!include ../../_common/style.puml

title Backoff Waiter Internal Flow - Core Only
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "LockAcquisitionService" as Acquire
participant "BackoffLockWaiter" as Waiter
participant "RetryBackoffSpec" as BackoffSpec
end box

Acquire -> Waiter : waitBeforeRetry(context)
Waiter -> BackoffSpec : calculateDelay(attempt)
BackoffSpec --> Waiter : delay
Waiter -> Waiter : sleep(delay)
Waiter --> Acquire : continue acquire loop / timeout

note right of Waiter
  This diagram describes wait calculation only.
  The next acquire attempt is shown in trylock-main-sequence.
end note

@enduml
