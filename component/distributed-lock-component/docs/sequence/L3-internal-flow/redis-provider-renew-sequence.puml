@startuml
!include ../../_common/style.puml

title RedisLockProvider Renew Internal Flow
autonumber
skinparam shadowing false

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as Provider
participant "RedisLockScriptExecutor" as ScriptExecutor
end box

database Redis

Provider -> ScriptExecutor : executeRenew(lockKey, ownerToken, leaseTime)
ScriptExecutor -> Redis : EVAL renew.lua
Redis --> ScriptExecutor : renewed / not owner / not found
ScriptExecutor --> Provider : raw result
alt renewed
  Provider --> Provider : LockRenewResponse(RENEWED)
else not owner / not found
  Provider --> Provider : LockRenewResponse(NOT_OWNER or NOT_FOUND)
else error
  Provider --> Provider : LockRenewResponse(PROVIDER_ERROR)
end

@enduml
