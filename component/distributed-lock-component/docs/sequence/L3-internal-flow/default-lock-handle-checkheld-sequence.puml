@startuml
!include ../../_common/style.puml

title DefaultLockHandle CheckHeld Internal Flow
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "DefaultLockHandle" as Handle
participant "LockRuntimeState" as RuntimeState
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Handle -> RuntimeState : ensureNotReleased()
RuntimeState --> Handle : ok
Handle -> LockProvider : check(request)
LockProvider -> RedisProvider : check(request)
RedisProvider -> Redis : check ownerToken
Redis --> RedisProvider : held / not owner / not found / error
RedisProvider --> LockProvider : LockCheckResponse
LockProvider --> Handle : check result
alt HELD
  Handle --> Handle : return true
else NOT_OWNER / NOT_FOUND
  Handle -> RuntimeState : markLost()
else PROVIDER_ERROR
  Handle --> Handle : return false / provider error
end

@enduml
