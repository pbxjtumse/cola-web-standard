@startuml
title tryLock Main Flow - Acquire / Wait / Fencing / Handle
autonumber
skinparam shadowing false

box "API Module" #D9EAF7
participant "DefaultDistributedLockClient" as Client
participant "AcquireOutcomeHandlerRegistry" as Outcome
participant "LockHandleFactory" as Factory
end box

box "Core Module" #DFF2BF
actor Caller
participant "LockAcquisitionService" as Acquire
participant "FencingTokenCoordinator" as Coordinator
participant "LockWaiter" as Waiter
participant "FencingTokenFlow" as Flow
participant "LockWatchdog" as Watchdog
end box

box "Provider Module" #FFE6CC
participant "LockProviderRegistry" as Registry
participant "LockProvider" as Provider
end box


Caller -> Client : tryLock(lockName, options)
Client -> Acquire : tryLock(lockName, options)
Acquire -> Acquire : validate lockName/options
Acquire -> Registry : getProvider(options.providerName)
Registry --> Acquire : provider
Acquire -> Coordinator : plan(provider, options)
Coordinator --> Acquire : FencingTokenPlan
Acquire -> Acquire : generate ownerToken
Acquire -> Waiter : waitForLock(request, provider)
Waiter -> Provider : acquire(request)
Provider --> Waiter : LockAcquireResponse
Waiter --> Acquire : response
Acquire -> Outcome : handle(context)

alt ACQUIRED
  Outcome -> Flow : complete(fencing context)
  Flow --> Outcome : FencingCompletion(success lease)
  Outcome -> Factory : create(provider, lease, options)
  Factory -> Watchdog : start(handle, options) if autoRenew
  Factory --> Outcome : DefaultLockHandle
  Outcome --> Acquire : LockResult(ACQUIRED, handle)
else NOT_ACQUIRED
  Outcome --> Acquire : LockResult(NOT_ACQUIRED)
else PROVIDER_ERROR
  Outcome --> Acquire : LockResult(PROVIDER_ERROR)
end

Acquire --> Client : LockResult
Client --> Caller : LockResult
@enduml