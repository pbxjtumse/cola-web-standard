@startuml
!include ../../_common/style.puml

title TryLock Main Flow - API to Core to SPI to Provider
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
participant "LockOptions" as Options
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "DefaultLockProviderRegistry" as Registry
participant "LockHandleFactory" as Factory
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Caller -> Client : tryLock(lockName, Options)
Client -> DefaultClient : tryLock(...)
DefaultClient -> Template : tryLock(...)
Template -> Acquire : acquire(lockName, options)
Acquire -> Registry : select(options.providerName)
Registry --> Acquire : LockProvider
Acquire -> LockProvider : acquire(LockAcquireRequest)
LockProvider -> RedisProvider : acquire(request)
RedisProvider -> Redis : Lua acquire(lockKey, ownerToken, leaseTime)
Redis --> RedisProvider : 1 / 0 / error
RedisProvider --> LockProvider : LockAcquireResponse
LockProvider --> Acquire : response

alt ACQUIRED
  Acquire -> Factory : create(lease, options)
  Factory --> Acquire : DefaultLockHandle
  Acquire --> Template : acquired handle
  Template --> DefaultClient : LockResult(ACQUIRED)
else NOT_ACQUIRED
  Acquire --> Template : LockResult(NOT_ACQUIRED)
else PROVIDER_ERROR
  Acquire --> Template : LockResult(PROVIDER_ERROR, ACQUIRE)
end

DefaultClient --> Client : LockResult
Client --> Caller : LockResult

@enduml
