@startuml
!include ../../_common/style.puml

title Watchdog Provider Managed Flow - Redisson Provider
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "LockAcquisitionService" as Acquire
participant "DefaultLockHandle" as Handle
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redisson" #FFE6CC
participant "RedissonLockProvider" as RedissonProvider
participant "Redisson internal watchdog" as RedissonWatchdog
end box

database Redis

Acquire -> LockProvider : acquire(request)
LockProvider -> RedissonProvider : acquire(request)
RedissonProvider -> Redis : acquire lock via Redisson
RedissonProvider -> RedissonWatchdog : start provider-managed renewal
RedissonWatchdog -> Redis : renew TTL internally
RedissonProvider --> LockProvider : ACQUIRED lease(autoRenewMode=PROVIDER_MANAGED)
LockProvider --> Acquire : lease
Acquire --> Handle : create handle

note right of RedissonWatchdog
  The provider implementation owns TTL renewal.
  Core does not schedule ScheduledLockWatchdog renew ticks
  for this provider-managed mode.
end note

@enduml
