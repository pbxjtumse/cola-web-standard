@startuml
title execute Main Flow - Acquire / Callback / Release / Resolve
autonumber
skinparam shadowing false
actor Caller
participant "DefaultDistributedLockClient" as Client
participant "LockExecutionTemplate" as Execute
participant "LockAcquisitionService" as Acquire
participant "LockCallback" as Callback
participant "DefaultLockHandle" as Handle
participant "LockResultResolver" as Resolver
participant "LockMetricsFacade" as Metrics

Caller -> Client : execute(lockName, options, callback)
Client -> Execute : execute(lockName, options, callback)
Execute -> Acquire : acquire(lockName, options)
Acquire --> Execute : AcquireAttempt

alt acquire not ACQUIRED
  Execute -> Execute : copyAcquireFailure(acquireResult)
  Execute --> Client : LockResult(status from acquire)
else acquire ACQUIRED
  Execute -> Callback : doWithLock(handle)
  alt callback success and handle not lost
    Callback --> Execute : value
    Execute -> Execute : ExecutionOutcome.success(value)
  else callback throws FencingTokenRejectedException
    Callback --> Execute : error
    Execute -> Execute : ExecutionOutcome(FENCING_REJECTED)
  else callback throws LockLostException or handle lost
    Callback --> Execute : error / handle.isLost
    Execute -> Execute : ExecutionOutcome(LOCK_LOST)
  else callback throws other Throwable
    Callback --> Execute : error
    Execute -> Execute : ExecutionOutcome(EXECUTION_FAILED)
  end
  Execute -> Handle : releaseWithOutcome()
  Handle --> Execute : LockReleaseOutcome
  Execute -> Resolver : resolve(executionOutcome, releaseOutcome, handle)
  Resolver --> Execute : LockResult
  Execute -> Metrics : recordHold(lease, status, holdDuration)
  Execute --> Client : LockResult
end

Client --> Caller : LockResult
@enduml
