@startuml
!include ../../_common/style.puml

title Execute Main Flow - Acquire Callback Release Resolve
autonumber
skinparam shadowing false

actor Caller

box "distributed-lock-api" #D9EAF7
participant "DistributedLockClient" as Client
participant "LockCallback" as Callback
end box

box "distributed-lock-core" #DFF2BF
participant "DefaultDistributedLockClient" as DefaultClient
participant "LockExecutionTemplate" as Template
participant "LockAcquisitionService" as Acquire
participant "LockWatchdog" as Watchdog
participant "DefaultLockHandle" as Handle
participant "LockResultResolver" as Resolver
participant "LockMetricsFacade" as Metrics
participant "LockEventPublisher" as Events
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Caller -> Client : execute(lockName, options, callback)
Client -> DefaultClient : execute(...)
DefaultClient -> Template : execute(...)
Template -> Acquire : acquire(...)
Acquire -> LockProvider : acquire(request)
LockProvider -> RedisProvider : acquire(request)
RedisProvider -> Redis : Lua acquire
Redis --> RedisProvider : acquired
RedisProvider --> LockProvider : ACQUIRED
LockProvider --> Acquire : ACQUIRED lease
Acquire --> Template : DefaultLockHandle
Template -> Watchdog : start(handle) when CORE_MANAGED

Template -> Callback : execute(handle)
alt callback success
  Callback --> Template : value
  Template -> Metrics : recordExecution(success=true)
else callback failed
  Callback --> Template : exception
  Template -> Metrics : recordExecution(success=false)
end

Template -> Handle : close()
Handle -> LockProvider : release(request)
LockProvider -> RedisProvider : release(request)
RedisProvider -> Redis : Lua release(ownerToken)
Redis --> RedisProvider : released / not owner / error
RedisProvider --> LockProvider : LockReleaseResponse
LockProvider --> Handle : release result
Handle --> Template : released / lost / error

Template -> Events : publish final event
Template -> Resolver : resolve(value, exception, releaseResult)
Resolver --> Template : LockResult
Template --> DefaultClient : LockResult
DefaultClient --> Client : LockResult
Client --> Caller : result

@enduml
