@startuml
title External JDBC Fencing Flow - Acquire Lock / Issue DB Token / Re-check Ownership
autonumber
skinparam shadowing false

box "API Module" #D9EAF7
participant "LockHandleFactory" as Factory
end box

box "Core Module" #DFF2BF
participant "LockAcquisitionService" as Acquire
participant "ExternalFencingTokenFlow" as Flow
end box

box "Provider Module" #FFE6CC
participant "LockProvider" as Provider
participant "JdbcSequenceFencingTokenProvider" as JdbcToken
end box


Acquire -> Provider : acquire(nativeFencingRequired=false)
Provider --> Acquire : LockAcquireResponse(lease without token)
Acquire -> Flow : complete(context)
Flow -> JdbcToken : nextToken(namespace, lockName, ownerToken)
JdbcToken --> Flow : token=N
Flow -> Flow : lease.withFencingToken(N, "jdbc-sequence")
Flow -> Provider : check(ownerToken)
alt still HELD
  Provider --> Flow : HELD
  Flow --> Acquire : FencingCompletion.success(fencedLease)
  Acquire -> Factory : create handle
else NOT_FOUND or NOT_OWNER
  Provider --> Flow : lock lost
  Flow --> Acquire : LockResult(LOCK_LOST, CHECK)
else PROVIDER_ERROR
  Provider --> Flow : error
  Flow -> Provider : best-effort release
  Flow --> Acquire : LockResult(PROVIDER_ERROR, CHECK)
end
@enduml