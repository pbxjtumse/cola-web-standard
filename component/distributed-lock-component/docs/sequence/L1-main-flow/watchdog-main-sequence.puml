@startuml
!include ../../_common/style.puml

title Watchdog Main Flow - Core Managed Summary
autonumber
skinparam shadowing false

box "distributed-lock-core" #DFF2BF
participant "LockHandleFactory" as Factory
participant "DefaultLockHandle" as Handle
participant "ScheduledLockWatchdog" as Watchdog
end box

box "distributed-lock-spi" #FFF2CC
participant "LockProvider" as LockProvider
end box

box "distributed-lock-provider-redis" #FFE6CC
participant "RedisLockProvider" as RedisProvider
end box

database Redis

Factory -> Watchdog : start(handle, options) when autoRenewMode=CORE_MANAGED
Watchdog -> Watchdog : schedule renew tick

loop each renew tick
  Watchdog -> Handle : renew()
  Handle -> LockProvider : renew(LockRenewRequest)
  LockProvider -> RedisProvider : renew(request)
  RedisProvider -> Redis : Lua renew(ownerToken, leaseTime)
  Redis --> RedisProvider : renewed / not owner / not found / error
  RedisProvider --> LockProvider : LockRenewResponse
  LockProvider --> Handle : renew result

  alt RENEWED
    Handle --> Watchdog : keep running
  else NOT_OWNER / NOT_FOUND
    Handle --> Watchdog : lock lost
    Watchdog -> Handle : markLostByWatchdog(...)
    Watchdog -> Watchdog : stop(handle)
  else PROVIDER_ERROR
    Handle --> Watchdog : provider error
    Watchdog -> Handle : markLostByWatchdog(...)
    Watchdog -> Watchdog : stop(handle)
  end
end

Handle -> Watchdog : stop(handle) on release/finally

@enduml
