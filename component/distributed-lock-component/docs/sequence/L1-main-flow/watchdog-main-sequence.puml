@startuml
title Watchdog Main Flow - Core Managed vs Provider Managed
autonumber
skinparam shadowing false
participant "LockHandleFactory" as Factory
participant "ScheduledLockWatchdog" as Watchdog
participant "DefaultLockHandle" as Handle
participant "LockProvider" as Provider

Factory -> Watchdog : start(handle, options) when autoRenew=true
Watchdog -> Watchdog : schedule tick by renewInterval

loop each tick until release/lost/maxRenewTime
  alt maxRenewTime exceeded
    Watchdog -> Handle : markLostByWatchdog("maxRenewTime exceeded")
    alt PROVIDER_MANAGED
      Watchdog -> Handle : unlock()
      Handle -> Provider : release(ownerToken)
    end
    Watchdog -> Watchdog : stop(handle)
  else CORE_MANAGED
    Watchdog -> Handle : renew()
    Handle -> Provider : renew(ownerToken, leaseTime)
    Provider --> Handle : RENEWED / NOT_OWNER / NOT_FOUND / ERROR
  else PROVIDER_MANAGED
    Watchdog -> Handle : checkHeld()
    Handle -> Provider : check(ownerToken)
    Provider --> Handle : HELD / NOT_OWNER / NOT_FOUND / ERROR
  end
end

Handle -> Watchdog : stop(handle) in release finally
@enduml
