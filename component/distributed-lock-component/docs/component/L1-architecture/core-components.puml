@startuml
title Distributed Lock Core - Component Collaboration
skinparam shadowing false
skinparam componentStyle rectangle

interface DistributedLockClient
component DefaultDistributedLockClient as Client
component LockAcquisitionService as Acquisition
component LockExecutionTemplate as Execution
component LockProviderRegistry as ProviderRegistry
interface LockProvider
component LockWaiterFactory as WaiterFactory
component FencingTokenCoordinator as FencingCoordinator
component FencingTokenFlowRegistry as FlowRegistry
component LockAcquireOutcomeHandlerRegistry as OutcomeRegistry
component LockHandleFactory as HandleFactory
component DefaultLockHandle as Handle
component LockWatchdog as Watchdog
component LockResultResolver as ResultResolver
component LockEventPublisher as EventPublisher
component LockMetricsFacade as Metrics

DistributedLockClient <|.. Client
Client --> Acquisition : tryLock
Client --> Execution : execute
Execution --> Acquisition : acquire
Execution --> ResultResolver : resolve final result
Acquisition --> ProviderRegistry : select provider
Acquisition --> FencingCoordinator : plan NONE/NATIVE/EXTERNAL
Acquisition --> WaiterFactory : choose wait strategy
Acquisition --> OutcomeRegistry : handle acquire response
OutcomeRegistry --> FlowRegistry : when ACQUIRED
OutcomeRegistry --> HandleFactory : create handle
HandleFactory --> Handle : create
HandleFactory --> Watchdog : start when autoRenew
Handle --> LockProvider : check/renew/release
Watchdog --> Handle : renew or checkHeld
Acquisition --> EventPublisher
Execution --> EventPublisher
Handle --> EventPublisher
Acquisition --> Metrics
Execution --> Metrics
Handle --> Metrics
ProviderRegistry --> LockProvider
@enduml

