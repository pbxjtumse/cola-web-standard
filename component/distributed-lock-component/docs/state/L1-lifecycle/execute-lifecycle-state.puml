@startuml
title execute() Lifecycle State
hide empty description
skinparam shadowing false

state START
state ACQUIRING
state NOT_ACQUIRED
state EXECUTING
state EXECUTION_SUCCESS
state EXECUTION_FAILED
state LOCK_LOST
state FENCING_REJECTED
state RELEASING
state SUCCESS
state RELEASE_FAILED

[*] --> START
START --> ACQUIRING : call execute
ACQUIRING --> NOT_ACQUIRED : acquire status != ACQUIRED
ACQUIRING --> EXECUTING : acquire ACQUIRED
EXECUTING --> EXECUTION_SUCCESS : callback returns
EXECUTING --> EXECUTION_FAILED : callback throws other Throwable
EXECUTING --> LOCK_LOST : LockLostException or handle.isLost
EXECUTING --> FENCING_REJECTED : FencingTokenRejectedException
EXECUTION_SUCCESS --> RELEASING
EXECUTION_FAILED --> RELEASING
LOCK_LOST --> RELEASING
FENCING_REJECTED --> RELEASING
RELEASING --> SUCCESS : execution success + release released/already attempted
RELEASING --> RELEASE_FAILED : release provider error
NOT_ACQUIRED --> [*]
SUCCESS --> [*]
RELEASE_FAILED --> [*]
@enduml
