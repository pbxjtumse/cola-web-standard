@startuml
title Business MyBatis + Iron Component Relational Access - Shared Transaction

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Controller
participant "Business Service / Template" as Service
participant "TransactionTemplate\n[High-level API]" as TX
participant "Transaction Context" as TxContext
participant "OrderRepository" as Repo
participant "MyBatis" as MyBatis
participant "JdbcIdempotencyStorage" as IdemStorage
participant "RelationalTemplate" as RT
participant "TransactionAwareConnectionProvider" as CP
database Database as DB

Controller -> Service : createOrder(command)
Service -> TX : execute(transaction callback)
TX -> DB : obtain physical Connection
TX -> TxContext : bind(Connection)

TX -> Service : invoke callback
Service -> Repo : save(order)
Repo -> MyBatis : mapper.insert(order)
MyBatis -> TxContext : obtain transaction-bound Connection
TxContext --> MyBatis : Connection A
MyBatis -> DB : INSERT business_order\nusing Connection A

Service -> IdemStorage : markSuccess(ownerToken, version)
IdemStorage -> RT : update(SqlStatement)
RT -> CP : acquire(context)
CP -> TxContext : currentConnection()
TxContext --> CP : Connection A
CP --> RT : ConnectionHandle(BORROWED, Connection A)
RT -> DB : UPDATE iron_idempotency\nusing same Connection A
DB --> RT : affectedRows
RT -> CP : ConnectionHandle.close()
note right of CP
BORROWED => do NOT physically close Connection A
end note
RT --> IdemStorage : UpdateResult
IdemStorage --> Service : WriteStatus.UPDATED

Service --> TX : callback success
TX -> DB : COMMIT Connection A
TX -> TxContext : unbind()
TX -> DB : physical close / return to pool
TX --> Service : transaction result
Service --> Controller : response

note over MyBatis,RT
MyBatis does NOT call RelationalTemplate.
RelationalTemplate does NOT wrap MyBatis.
They share transaction infrastructure and the same physical Connection.
end note

@enduml
