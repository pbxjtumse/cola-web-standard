<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xjtu.iron</groupId>
        <artifactId>concurrency-component</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>concurrency-core</artifactId>
    <packaging>jar</packaging>
    <name>concurrency-core</name>
    <dependencies>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>com.xjtu.iron</groupId>
            <artifactId>concurrency-api</artifactId>
        </dependency>
        <!-- AssertJ：比原生 assertEquals 好读很多 -->
        <!-- Mockito：验证 listener 是否调用、调用几次 -->
        <!-- Awaitility：异步测试必备 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 源码直接使用 AssertJ，测试模块显式声明，避免依赖传递关系。 -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
