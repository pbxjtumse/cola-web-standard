@startuml
title Idempotency - Main execute()

actor Caller
participant "IdempotencyExecutor" as E
participant "PolicyRegistry" as P
participant "DistributedLock\n(optional)" as L
participant "Repository" as R
participant "StateMachine" as S
participant "TransactionCoordinator\n(optional)" as T
participant "Business" as B
participant "ResultPolicy<T>" as RP

Caller -> E : execute(request, resultPolicy, callback)
E -> P : resolve(policyName / inline policy)
P --> E : policy

opt short lock enabled
  E -> L : acquire(state key)
end

E -> R : tryAcquire(request)\natomic CAS/Lua/short Tx-A
R --> E : AcquireResult

opt short lock acquired
  E -> L : release()
end

E -> S : onAcquire(status)
S --> E : EXECUTE / REPLAY / RETURN

alt EXECUTE
  alt Repository participates in business transaction
    E -> T : executeRequired(Tx-B)
    T -> B : callback()
    B --> T : T
    T -> RP : capture(T)
    RP --> T : stored payload
    T -> R : markSuccess(owner,version,payload)
    R --> T : UPDATED
    T --> E : transaction result
  else no local business transaction
    E -> B : callback()
    B --> E : T
    E -> RP : capture(T)
    RP --> E : stored payload
    E -> R : markSuccess(owner,version,payload)
    R --> E : WriteResult
  end
  E --> Caller : EXECUTED
else REPLAY
  E -> RP : replay(stored payload)
  RP --> E : T / null
  E --> Caller : REPLAYED
else RETURN
  E --> Caller : PROCESSING / conflict / failure state
end
@enduml
