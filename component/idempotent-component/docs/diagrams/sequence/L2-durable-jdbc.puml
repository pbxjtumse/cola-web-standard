@startuml
title DURABLE JDBC + Transaction Integration V1.3

actor Caller
participant "Executor" as E
participant "JDBC Repository" as R
participant "TransactionExecutor" as TX
participant "Business" as B
participant "ResultPolicy" as RP

Caller -> E : execute()

group Tx-A REQUIRES_NEW
  E -> R : tryAcquire()
  R -> R : UNIQUE / SELECT FOR UPDATE\nPROCESSING owner=A version=1
  R --> E : ACQUIRED
end

note over E,R
Tx-A is committed before long business execution.
PROCESSING becomes visible quickly.
end note

group Tx-B REQUIRED
  E -> TX : executeRequired()
  TX -> B : callback()
  B --> TX : value
  TX -> RP : capture(value)
  RP --> TX : payload
  TX -> R : markSuccess(A,1,payload)
  alt UPDATED
    R --> TX : UPDATED
    TX --> E : value
  else stale owner / already final
    R --> TX : rejected
    TX -> TX : throw -> rollback Tx-B
    TX --> E : ownership lost
  end
end

alt business / transaction failure with known rollback
  group Tx-C REQUIRES_NEW
    E -> R : markFailed(A,1)
    R --> E : write result
  end
end

E --> Caller : IdempotencyResult
@enduml
