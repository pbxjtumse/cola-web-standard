@startuml
title Idempotency V1.3 - Reliable Recovery

participant "Reliable Task" as Task
participant "RecoveryQueryService" as Q
participant "PolicyRegistry" as P
participant "Repository" as R
participant "IdempotencyExecutor" as E
participant "StateMachine" as S
participant "Business / Tx-B" as B

Task -> Q : findCandidates(policyName, query)
Q -> P : resolve(policyName)
P --> Q : policy
Q -> R : findRecoveryCandidates(query)
R --> Q : candidate(owner=A, version=10)
Q --> Task : candidate

... queue/schedule delay ...

Task -> E : recover(expectedOwner=A,\nexpectedVersion=10)
E -> R : tryRecover(...)\natomic re-check

alt candidate still current and policy allows
  R -> R : owner=B\nversion=11\nstatus=PROCESSING
  R --> E : RECOVERY_ACQUIRED
  E -> S : onRecovery(RECOVERY_ACQUIRED)
  S --> E : EXECUTE
  E -> B : execute generation B/11
  B --> E : success/failure
  E --> Task : RECOVERED / failure
else candidate stale
  R --> E : STALE_CANDIDATE
  E -> S : onRecovery(STALE_CANDIDATE)
  S --> E : RETURN
  E --> Task : STALE_RECOVERY_CANDIDATE
end
@enduml
