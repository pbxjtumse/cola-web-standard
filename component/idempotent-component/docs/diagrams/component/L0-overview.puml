@startuml
title Idempotent Component V1.3 - L0

skinparam componentStyle rectangle

actor Caller

rectangle "idempotent-api" {
  [IdempotencyExecutor]
  [IdempotencyRequest]
  [IdempotencyPolicy]
  [ResultPolicy<T>]
  [RecoveryPolicy]
}

rectangle "idempotent-core" {
  [PolicyRegistry]
  [RepositoryRegistry]
  [StateMachine]
  [DefaultIdempotencyExecutor]
}

rectangle "providers" {
  [Redis Repository\nWINDOWED]
  [JDBC Repository\nWINDOWED / DURABLE]
}

rectangle "optional integrations" {
  [DistributedLockClient\ncontention reduction]
  [transaction-component\nBusiness + SUCCESS]
}

rectangle "external reliable task" {
  [Recovery Scanner / Scheduler]
}

Caller --> [IdempotencyExecutor]
[IdempotencyExecutor] --> [DefaultIdempotencyExecutor]
[DefaultIdempotencyExecutor] --> [PolicyRegistry]
[DefaultIdempotencyExecutor] --> [RepositoryRegistry]
[DefaultIdempotencyExecutor] --> [StateMachine]
[RepositoryRegistry] --> [Redis Repository\nWINDOWED]
[RepositoryRegistry] --> [JDBC Repository\nWINDOWED / DURABLE]
[DefaultIdempotencyExecutor] ..> [DistributedLockClient\ncontention reduction] : optional short lock
[DefaultIdempotencyExecutor] ..> [transaction-component\nBusiness + SUCCESS] : optional local tx
[Recovery Scanner / Scheduler] --> [IdempotencyExecutor] : recover()
@enduml
