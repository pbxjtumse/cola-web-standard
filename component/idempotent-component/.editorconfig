root = true

[*.java]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
continuation_indent_size = 4
max_line_length = 140

# 阅读型代码风格：
# 1. 一条完整语句在 140 字符内能清晰表达时，不为了“形式对齐”强制拆行；
# 2. 构造器/方法参数较多或语义分组明显时才换行；
# 3. SQL、Builder 链、长泛型和注释优先保证可读性，不为了压成一行而牺牲结构。
