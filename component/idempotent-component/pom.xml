<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xjtu.iron</groupId>
        <artifactId>component</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>idempotent-component</artifactId>
    <packaging>pom</packaging>
    <name>idempotent-component</name>

    <modules>
        <module>idempotent-api</module>
        <module>idempotent-core</module>
        <module>idempotent-provider</module>
        <module>idempotent-starter</module>
        <module>idempotent-demo</module>
    </modules>

    <!--
       统一导入技术组件 BOM。
       子模块声明 com.xjtu.iron 内部依赖时不再重复写 version；
       真正是否引入依赖仍由各子模块自己的 <dependencies> 决定。
   -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.xjtu.iron</groupId>
                <artifactId>component-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
