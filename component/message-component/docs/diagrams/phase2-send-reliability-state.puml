@startuml
!include _common/style.puml

title 二期可靠发送状态入口图

[*] --> PREPARE
state "PREPARE\n校验 / enrich / route / encode" as PREPARE #EDE7F6
state "ATTEMPT\nProvider 发送" as ATTEMPT #ECEFF1
state "CLASSIFY\n结果分类" as CLASSIFY #FFF3E0
state "BACKOFF\n等待下一次" as BACKOFF #FCE4EC
state "CONFIRMED" as CONFIRMED #DCFCE7
state "FAILED" as FAILED #FEE2E2
state "REJECTED" as REJECTED #FFE4E6
state "UNKNOWN" as UNKNOWN #FEF3C7

PREPARE --> REJECTED: 准备阶段拒绝
PREPARE --> ATTEMPT: 准备完成
ATTEMPT --> CLASSIFY: Provider 结果
CLASSIFY --> CONFIRMED: 确认成功
CLASSIFY --> BACKOFF: 可重试失败
BACKOFF --> ATTEMPT: 下一次尝试
BACKOFF --> FAILED: 耗尽且最后明确失败
BACKOFF --> UNKNOWN: 耗尽且最后状态不明
CLASSIFY --> REJECTED: 明确拒绝
CLASSIFY --> UNKNOWN: 状态不明且默认停止
CLASSIFY --> FAILED: 不可重试失败
CONFIRMED --> [*]
FAILED --> [*]
REJECTED --> [*]
UNKNOWN --> [*]
@enduml
