@startuml
!include ../../../_common/style.puml

title Consume L3 - Pulsar Consume Flow

box "Provider" #FFEBEE
participant PulsarConsumer
participant PulsarConsumerDispatcherAdapter
end box
box "Core Consume" #FFF3E0
participant ProviderMessageListener
end box

PulsarConsumer -> PulsarConsumerDispatcherAdapter: received(message)
PulsarConsumerDispatcherAdapter -> ProviderMessageListener: onMessage(inbound)
ProviderMessageListener --> PulsarConsumerDispatcherAdapter: ProviderConsumeResult
alt result.decision().shouldAcknowledge()
  PulsarConsumerDispatcherAdapter -> PulsarConsumer: acknowledge(message)
else RETRY / DEAD_LETTER
  PulsarConsumerDispatcherAdapter -> PulsarConsumer: negativeAcknowledge(message)
end
@enduml
