@startuml
!include ../../../_common/style.puml

title Consume L3 - Kafka Partition Ordered Consume

box "Provider" #FFEBEE
participant KafkaConsumer
participant KafkaConsumerDispatcherAdapter
end box
box "Core Consume" #FFF3E0
participant ProviderMessageListener
end box

KafkaConsumer -> KafkaConsumer: poll(records)
KafkaConsumer -> KafkaConsumerDispatcherAdapter: dispatch(records)
KafkaConsumerDispatcherAdapter -> KafkaConsumerDispatcherAdapter: groupByTopicPartition(records)
loop each partition, offset order
  KafkaConsumerDispatcherAdapter -> ProviderMessageListener: onMessage(inbound)
  ProviderMessageListener --> KafkaConsumerDispatcherAdapter: ProviderConsumeResult
  alt result.decision().shouldAcknowledge()
    KafkaConsumerDispatcherAdapter -> KafkaConsumerDispatcherAdapter: commit offset + 1
  else RETRY / DEAD_LETTER
    KafkaConsumerDispatcherAdapter -> KafkaConsumerDispatcherAdapter: no commit / seek current offset
    KafkaConsumerDispatcherAdapter -> KafkaConsumerDispatcherAdapter: stop current partition
  end
end
@enduml
