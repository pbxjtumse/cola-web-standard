@startuml
!include ../../../_common/style.puml

title Consume L0 - Reliable Consume Overview V4
left to right direction

package "Broker" #FFFDE7 {
  [Kafka]
  [Pulsar]
  [RocketMQ]
}
package "Provider" #FFEBEE {
  [KafkaMessageProvider]
  [PulsarMessageProvider]
  [RocketMqMessageProvider]
  [ProviderInboundMessage]
}
package "SPI" #ECEFF1 {
  [ProviderMessageListener]
  [ProviderConsumeResult]
}
package "Core Consume" #FFF3E0 {
  [MessageConsumerAdapter]
  [MessageConsumeExecutor]
  [IdempotencyStrategy]
  [MessageIdempotencyExecutor]
  [TransactionStrategy]
  [MessageConsumeTransactionExecutor]
  [MessageHandlerInvoker]
}
package "Business" #E8F5E9 {
  [MessageHandler]
}
package "Idempotent Component" #FCE4EC {
  [MessageIdempotentOperations]
  [IdempotentStorage]
}
package "Transaction Component" #E0F2F1 {
  [TransactionTemplate]
}

[Kafka] --> [KafkaMessageProvider]
[Pulsar] --> [PulsarMessageProvider]
[RocketMQ] --> [RocketMqMessageProvider]
[KafkaMessageProvider] --> [ProviderInboundMessage]
[PulsarMessageProvider] --> [ProviderInboundMessage]
[RocketMqMessageProvider] --> [ProviderInboundMessage]
[ProviderInboundMessage] --> [ProviderMessageListener]
[ProviderMessageListener] --> [MessageConsumerAdapter]
[MessageConsumerAdapter] --> [MessageConsumeExecutor]
[MessageConsumeExecutor] --> [IdempotencyStrategy]
[IdempotencyStrategy] --> [MessageIdempotencyExecutor]
[MessageIdempotencyExecutor] --> [MessageIdempotentOperations]
[MessageIdempotencyExecutor] --> [TransactionStrategy]
[TransactionStrategy] --> [MessageConsumeTransactionExecutor]
[MessageConsumeTransactionExecutor] --> [TransactionTemplate]
[TransactionStrategy] --> [MessageHandlerInvoker]
[MessageHandlerInvoker] --> [MessageHandler]
[MessageIdempotentOperations] --> [IdempotentStorage]
[MessageConsumerAdapter] --> [ProviderConsumeResult]
@enduml
