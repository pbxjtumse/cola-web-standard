@startuml
!include ../../../_common/style.puml

title Consume L1 - Core Consume Main Flow

box "Provider" #FFEBEE
participant "Native Consumer" as NativeConsumer
participant "ProviderInboundMessage" as Inbound
end box
box "SPI" #ECEFF1
participant ProviderMessageListener
end box
box "Core Consume" #FFF3E0
participant MessageConsumeDispatcher
participant ConsumerDefinitionRegistry
participant MessageWireCodec
participant DefaultConsumeContextFactory
participant ConsumeExecutionTemplate
end box
box "Business" #E8F5E9
participant MessageHandler
end box

NativeConsumer -> Inbound: convert(nativeMessage)
NativeConsumer -> ProviderMessageListener: onMessage(inbound)
ProviderMessageListener -> MessageConsumeDispatcher: dispatch(inbound)
MessageConsumeDispatcher -> ConsumerDefinitionRegistry: find(inbound)
MessageConsumeDispatcher -> MessageWireCodec: decode(definition, destination, inbound)
MessageConsumeDispatcher -> DefaultConsumeContextFactory: create(inbound, envelope, definition)
MessageConsumeDispatcher -> ConsumeExecutionTemplate: execute(envelope, context, handler)
ConsumeExecutionTemplate -> MessageHandler: handle(envelope, context)
MessageHandler --> ConsumeExecutionTemplate: ConsumeDecision
ConsumeExecutionTemplate --> MessageConsumeDispatcher: ConsumeDecision
MessageConsumeDispatcher --> ProviderMessageListener: ProviderConsumeResult
ProviderMessageListener --> NativeConsumer: map decision to ack/retry/discard
@enduml
