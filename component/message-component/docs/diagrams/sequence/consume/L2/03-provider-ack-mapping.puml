@startuml
!include ../../../_common/style.puml

title Consume L2 - ConsumeDecision Provider Ack Mapping

box "Core Consume" #FFF3E0
participant ProviderMessageListener
end box
box "Provider" #FFEBEE
participant KafkaMessageProvider
participant PulsarMessageProvider
participant RocketMqMessageProvider
end box

KafkaMessageProvider -> ProviderMessageListener: onMessage(inbound)
ProviderMessageListener --> KafkaMessageProvider: ProviderConsumeResult
alt result.decision().shouldAcknowledge()
  KafkaMessageProvider -> KafkaMessageProvider: commit offset + 1
else RETRY / DEAD_LETTER
  KafkaMessageProvider -> KafkaMessageProvider: no commit / seek current offset
end

PulsarMessageProvider -> ProviderMessageListener: onMessage(inbound)
ProviderMessageListener --> PulsarMessageProvider: ProviderConsumeResult
alt result.decision().shouldAcknowledge()
  PulsarMessageProvider -> PulsarMessageProvider: acknowledge(message)
else RETRY / DEAD_LETTER
  PulsarMessageProvider -> PulsarMessageProvider: negativeAcknowledge(message)
end

RocketMqMessageProvider -> ProviderMessageListener: onMessage(inbound)
ProviderMessageListener --> RocketMqMessageProvider: ProviderConsumeResult
alt result.decision().shouldAcknowledge()
  RocketMqMessageProvider -> RocketMqMessageProvider: return CONSUME_SUCCESS
else RETRY / DEAD_LETTER
  RocketMqMessageProvider -> RocketMqMessageProvider: return RECONSUME_LATER
end
@enduml
