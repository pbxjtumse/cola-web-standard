@startuml
!include ../../../_common/style.puml

title Consume L2 - Transaction Boundary V4

box "Core Consume" #FFF3E0
participant MessageConsumeExecutor
participant IdempotencyStrategy
participant MessageIdempotencyExecutor
participant TransactionStrategy
participant MessageConsumeTransactionExecutor
participant MessageHandlerInvoker
end box
box "Business" #E8F5E9
participant MessageHandler
end box
box "Idempotent Component" #FCE4EC
participant MessageIdempotentOperations
end box
box "Transaction Component" #E0F2F1
participant TransactionTemplate
end box
box "Provider" #FFEBEE
participant ProviderAckMapper
end box

MessageConsumeExecutor -> IdempotencyStrategy: execute(definition, message, context, invocation)
IdempotencyStrategy -> MessageIdempotencyExecutor: execute(message, context, options, invocation)
MessageIdempotencyExecutor -> MessageIdempotentOperations: acquire(context)
MessageIdempotentOperations --> MessageIdempotencyExecutor: ACQUIRED
MessageIdempotencyExecutor -> TransactionStrategy: invocation.invoke()
TransactionStrategy -> MessageConsumeTransactionExecutor: execute(transactionContext, callback)
MessageConsumeTransactionExecutor -> TransactionTemplate: execute(callback)
TransactionTemplate -> MessageHandlerInvoker: invoke(message, context, handler)
MessageHandlerInvoker -> MessageHandler: handle(envelope, context)
alt ACK / DISCARD
  MessageHandler --> MessageHandlerInvoker: ACK / DISCARD
  MessageHandlerInvoker --> TransactionTemplate: ACK / DISCARD
  TransactionTemplate --> MessageConsumeTransactionExecutor: commit
  MessageConsumeTransactionExecutor --> TransactionStrategy: ACK / DISCARD
  TransactionStrategy --> MessageIdempotencyExecutor: ACK / DISCARD
  MessageIdempotencyExecutor -> MessageIdempotentOperations: markSuccess / markDiscarded
  MessageIdempotencyExecutor -> ProviderAckMapper: complete(ACK / DISCARD)
else RETRY / DEAD_LETTER
  MessageHandler --> MessageHandlerInvoker: exception or failure decision
  MessageHandlerInvoker --> TransactionStrategy: RETRY / DEAD_LETTER
  TransactionStrategy -> MessageConsumeTransactionExecutor: throw internal rollback exception
  TransactionTemplate --> MessageConsumeTransactionExecutor: rollback
  TransactionStrategy --> MessageIdempotencyExecutor: original decision
  MessageIdempotencyExecutor -> MessageIdempotentOperations: markFailed(best effort)
  MessageIdempotencyExecutor -> ProviderAckMapper: complete(RETRY / DEAD_LETTER)
end
@enduml
