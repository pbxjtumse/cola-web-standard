@startuml
!include ../../_common/style.puml

title L4：Kafka 发送结果映射（方法级）

box "Kafka Provider\nmessage-integration-kafka" #FFEBEE
participant "KafkaMessageProvider" as Provider
participant "KafkaProducer" as Producer
end box
box "Broker" #FFFDE7
queue "Kafka Topic" as Topic
end box
box "SPI\nmessage-spi" #ECEFF1
participant "ProviderSendResult" as Result
end box

Provider -> Producer: send(producerRecord, callback)
alt RecordMetadata returned
  Producer -> Topic: append
  Topic --> Producer: RecordMetadata
  Producer --> Provider: callback(metadata, null)
  Provider -> Result: confirmed(providerMessageId, metadata)
else SerializationException
  Producer --> Provider: callback(null, exception)
  Provider -> Provider: classifySendFailure(exception)
  Provider -> Result: failed(REJECTED, SERIALIZATION_ERROR, ...)
else AuthorizationException
  Producer --> Provider: callback(null, exception)
  Provider -> Provider: classifySendFailure(exception)
  Provider -> Result: failed(REJECTED, AUTHORIZATION_ERROR, ...)
else NetworkException / DisconnectException
  Producer --> Provider: callback(null, exception)
  Provider -> Provider: classifySendFailure(exception)
  Provider -> Result: failed(FAILED, NETWORK_ERROR, ...)
else TimeoutException
  Producer --> Provider: callback(null, exception)
  Provider -> Provider: classifySendFailure(exception)
  Provider -> Result: failed(UNKNOWN, TIMEOUT, ...)
else other client error
  Producer --> Provider: callback(null, exception)
  Provider -> Provider: classifySendFailure(exception)
  Provider -> Result: failed(FAILED, CLIENT_ERROR, ...)
end
@enduml
