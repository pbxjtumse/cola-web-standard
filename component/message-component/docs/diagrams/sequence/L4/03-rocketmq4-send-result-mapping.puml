@startuml
!include ../../_common/style.puml

title L4：RocketMQ4 发送结果映射（方法级）

box "RocketMQ4 Provider\nmessage-integration-rocketmq" #FFEBEE
participant "RocketMqMessageProvider" as Provider
participant "DefaultMQProducer" as Producer
end box
box "Broker" #FFFDE7
queue "RocketMQ4 Broker" as Broker
end box
box "SPI\nmessage-spi" #ECEFF1
participant "ProviderSendResult" as Result
end box

Provider -> Producer: send(message, callback)
alt SEND_OK
  Producer -> Broker: async send
  Broker --> Producer: SendResult(SEND_OK)
  Producer --> Provider: onSuccess(sendResult)
  Provider -> Result: confirmed(msgId, sendMetadata)
else FLUSH_DISK_TIMEOUT / FLUSH_SLAVE_TIMEOUT / SLAVE_NOT_AVAILABLE
  Broker --> Producer: SendResult(non SEND_OK)
  Producer --> Provider: onSuccess(sendResult)
  Provider -> Provider: classifySendStatus(sendResult)
  Provider -> Result: failed(UNKNOWN, UNKNOWN_OUTCOME, ...)
else other non SEND_OK
  Broker --> Producer: SendResult(non SEND_OK)
  Producer --> Provider: onSuccess(sendResult)
  Provider -> Provider: classifySendStatus(sendResult)
  Provider -> Result: failed(FAILED, BROKER_REJECTED, ...)
else Remoting / NameServer / connect exception
  Producer --> Provider: onException(throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(FAILED, NETWORK_ERROR, ...)
else timeout
  Producer --> Provider: onException(throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(UNKNOWN, TIMEOUT, ...)
else route / topic / ACL
  Producer --> Provider: onException(throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(REJECTED, ROUTING_ERROR / AUTHENTICATION_ERROR, ...)
end
@enduml
