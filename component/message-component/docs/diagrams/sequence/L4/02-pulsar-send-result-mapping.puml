@startuml
!include ../../_common/style.puml

title L4：Pulsar 发送结果映射（方法级）

box "Pulsar Provider\nmessage-integration-pulsar" #FFEBEE
participant "PulsarMessageProvider" as Provider
participant "Producer<byte[]>" as Producer
end box
box "Broker" #FFFDE7
queue "Pulsar Topic" as Topic
end box
box "SPI\nmessage-spi" #ECEFF1
participant "ProviderSendResult" as Result
end box

Provider -> Producer: newMessage().key(...).properties(...).value(...).sendAsync()
alt MessageId returned
  Producer -> Topic: publish
  Topic --> Producer: MessageId
  Producer --> Provider: whenComplete(messageId, null)
  Provider -> Result: confirmed(messageId.toString())
else TimeoutException
  Producer --> Provider: whenComplete(null, throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(UNKNOWN, TIMEOUT, ...)
else AuthorizationException
  Producer --> Provider: whenComplete(null, throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(REJECTED, AUTHORIZATION_ERROR, ...)
else NotFound / invalid topic
  Producer --> Provider: whenComplete(null, throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(REJECTED, ROUTING_ERROR, ...)
else connection / broker unavailable
  Producer --> Provider: whenComplete(null, throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(FAILED, NETWORK_ERROR, ...)
else other client error
  Producer --> Provider: whenComplete(null, throwable)
  Provider -> Provider: classifySendFailure(throwable)
  Provider -> Result: failed(FAILED, CLIENT_ERROR, ...)
end
@enduml
