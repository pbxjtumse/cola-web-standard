@startuml
!include ../../_common/style.puml

title L3：发送准备阶段失败流程（方法级）

actor Caller as "业务代码"

box "Core 模块\nmessage-core" #EDE7F6
participant "MessageTemplate\ncore" as Template
participant "MessageEnvelopeEnricher\ncore.enrich" as Enricher
participant "DestinationResolver\ncore.routing" as Resolver
participant "MessageProviderRegistry\ncore.provider" as Registry
participant "MessageWireCodec\ncore.codec" as Codec
end box

box "API 模块\nmessage-api" #E3F2FD
participant "SendResult\napi.publish" as Result
end box

Caller -> Template: send(destination, envelope, options)
Template -> Template: prepare(...)
alt destination or message is null
  Template -> Template: throw PreparationException(VALIDATE)
else enrich failure
  Template -> Enricher: enrich(message)
  Enricher --> Template: RuntimeException
  Template -> Template: throw PreparationException(ENRICH)
else route failure
  Template -> Resolver: resolve(destination)
  Resolver --> Template: RuntimeException
  Template -> Template: throw PreparationException(RESOLVE)
else provider missing
  Template -> Registry: getRequired(providerName)
  Registry --> Template: RuntimeException
  Template -> Template: throw PreparationException(PROVIDER_NOT_FOUND)
else serialization failure
  Template -> Codec: encode(...)
  Codec --> Template: RuntimeException
  Template -> Template: throw PreparationException(SERIALIZE)
end
Template -> Template: preparationFailure(destination, message, startedAt, exception)
Template -> Result: new SendResult(...)
Result --> Template: REJECTED / FAILED
Template --> Caller: SendResult
@enduml
