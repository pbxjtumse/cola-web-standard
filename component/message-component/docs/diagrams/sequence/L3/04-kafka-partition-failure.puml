@startuml
!include ../../_common/style.puml

title L3：Kafka 分区消费失败处理（方法级）

box "Kafka Provider\nmessage-integration-kafka" #FFEBEE
participant "KafkaConsumerWorker" as Worker
participant "KafkaConsumer" as Consumer
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "ProviderSubscriptionRequest\nspi" as Request
participant "ProviderInboundMessage\nspi" as Inbound
end box
box "Broker" #FFFDE7
queue "Kafka Topic" as Topic
end box

Worker -> Consumer: poll(pollTimeout)
Consumer -> Topic: fetch records
Topic --> Consumer: ConsumerRecords
Worker -> Inbound: toInbound(record)
Worker -> Request: listener().onMessage(inbound)
Request --> Worker: ConsumeDecision
alt SUCCESS
  Worker -> Consumer: commitSync()
else RETRY
  Worker -> Consumer: seek(record.partition(), record.offset())
else exception
  Worker -> Consumer: seek(record.partition(), record.offset())
end
@enduml
