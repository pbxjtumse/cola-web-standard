@startuml
!include ../../_common/style.puml

title L3：重试耗尽流程（方法级）

box "Core Send Reliability\nmessage-core.send.reliability" #FFF3E0
participant "DefaultReliableMessageSender" as ReliableSender
participant "MessageSendRetryClassifier" as Classifier
end box
box "Retry Component" #FCE4EC
participant "RetryExecutor" as RetryExecutor
participant "RetryResult" as RetryResult
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider" as Provider
participant "ProviderSendResult" as ProviderResult
end box
box "API 模块\nmessage-api" #E3F2FD
participant "SendResult" as SendResult
end box

ReliableSender -> RetryExecutor: execute(execution)
loop until maxAttempts
  RetryExecutor -> ReliableSender: doProviderSendAttempt(prepared)
  ReliableSender -> Provider: send(request)
  Provider --> ReliableSender: ProviderSendResult(FAILED, NETWORK_ERROR)
  ReliableSender --> RetryExecutor: ProviderSendResult
  RetryExecutor -> Classifier: classify(attempt)
  Classifier --> RetryExecutor: RetryDecision.retry(...)
end
RetryExecutor --> RetryResult: EXHAUSTED
RetryResult --> ReliableSender: RetryResult
ReliableSender -> ReliableSender: retryExhaustedResult(prepared, retryResult, reliabilityInfo)
alt last ProviderSendResult is UNKNOWN
  ReliableSender -> SendResult: new SendResult(UNKNOWN, RETRY_EXHAUSTED, ...)
else last ProviderSendResult is FAILED
  ReliableSender -> SendResult: new SendResult(FAILED, RETRY_EXHAUSTED, ...)
end
SendResult --> ReliableSender: SendResult
@enduml
