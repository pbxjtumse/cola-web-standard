@startuml
!include ../../_common/style.puml

title L3：发送确认超时流程（方法级）

actor Caller as "MessageTemplate"

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "DirectMessageSender / DefaultReliableMessageSender" as Sender
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSendResult\nspi" as ProviderResult
end box
box "API 模块\nmessage-api" #E3F2FD
participant "SendResult\napi.publish" as Result
end box

Caller -> Sender: send(prepared)
Sender -> Provider: send(request)
Provider --> Sender: CompletionStage<ProviderSendResult>
Sender -> Sender: get(confirmTimeout)
alt confirmed before timeout
  Sender -> Sender: mapProviderResult(...)
  Sender -> Result: new SendResult(CONFIRMED, ...)
else TimeoutException
  Sender -> ProviderResult: failed(UNKNOWN, TIMEOUT, description)
  ProviderResult --> Sender: ProviderSendResult
  Sender -> Sender: mapProviderResult(...)
  Sender -> Result: new SendResult(UNKNOWN, TIMEOUT, ...)
end
Result --> Caller: SendResult
@enduml
