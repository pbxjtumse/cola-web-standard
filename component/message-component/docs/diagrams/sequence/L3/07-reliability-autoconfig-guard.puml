@startuml
!include ../../_common/style.puml

title L3：可靠发送自动装配保护（方法级）

box "Starter / Config\nmessage-starter" #F3E8FF
participant "MessageAutoConfiguration" as AutoConfig
participant "MessageSendReliabilityProperties" as Properties
end box
box "Core Send\nmessage-core.send" #FFF3E0
participant "DirectMessageSender" as DirectSender
participant "DefaultReliableMessageSender" as ReliableSender
end box
box "Retry Component" #FCE4EC
participant "RetryExecutor" as RetryExecutor
participant "RetryPolicyRegistry" as PolicyRegistry
end box

AutoConfig -> AutoConfig: messageSendReliabilityOptions(properties)
AutoConfig -> Properties: getReliability().getSend()
Properties --> AutoConfig: enabled / retryPolicy / retryWhenUnknown
AutoConfig -> AutoConfig: messageSendExecutor(...)
alt reliability.send.enabled = false
  AutoConfig -> DirectSender: new DirectMessageSender(clock)
  DirectSender --> AutoConfig: MessageSendExecutor
else reliability.send.enabled = true and retry beans exist
  AutoConfig -> RetryExecutor: getIfAvailable()
  AutoConfig -> PolicyRegistry: getIfAvailable()
  AutoConfig -> ReliableSender: new DefaultReliableMessageSender(...)
  ReliableSender --> AutoConfig: MessageSendExecutor
else reliability.send.enabled = true and retry beans missing
  AutoConfig -> AutoConfig: throw IllegalStateException
end
@enduml
