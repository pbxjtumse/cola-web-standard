@startuml
!include ../../_common/style.puml

title L0：消息组件生命周期总览（方法级主链路）

actor Caller as "业务系统 / Demo"

box "API 模块\nmessage-api" #E3F2FD
participant "MessagePublisher\napi.publish" as Publisher
participant "MessageConsumerRegistrar\napi.consume" as Registrar
participant "MessageHandler\napi.consume" as Handler
end box

box "Core 模块\nmessage-core" #EDE7F6
participant "MessageTemplate\ncore" as Template
participant "MessageWireCodec\ncore.codec" as Codec
participant "CurrentMessage\ncore.context" as Current
end box

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "MessageSendExecutor\ncore.send" as SendExecutor
participant "DefaultReliableMessageSender\ncore.send.reliability" as ReliableSender
end box

box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSendResult\nspi" as ProviderResult
end box

box "Provider 模块\nmessage-integrations" #FFEBEE
participant "KafkaMessageProvider / PulsarMessageProvider / RocketMqMessageProvider" as ProviderImpl
end box

box "Broker" #FFFDE7
queue "Kafka / Pulsar / RocketMQ4" as Broker
end box

Caller -> Publisher: send(destination, envelope, options)
Publisher -> Template: send(...)
Template -> Template: prepare(...)
Template -> SendExecutor: send(prepared)
SendExecutor -> ReliableSender: send(prepared)
ReliableSender -> Provider: send(request)
Provider -> ProviderImpl: send(request)
ProviderImpl -> Broker: native send
Broker --> ProviderImpl: ack / exception / timeout
ProviderImpl --> Provider: ProviderSendResult
Provider --> ReliableSender: ProviderSendResult
ReliableSender --> SendExecutor: SendResult
SendExecutor --> Template: SendResult
Template --> Caller: SendResult

Caller -> Registrar: subscribe(definition, handler)
Registrar -> Template: subscribe(...)
Template -> Provider: subscribe(providerRequest)
Provider -> ProviderImpl: subscribe(request)
ProviderImpl -> Broker: subscribe / poll / listener
Broker --> ProviderImpl: native message
ProviderImpl -> Codec: decode(definition, providerDestination, inbound)
Codec --> ProviderImpl: DecodedInbound
ProviderImpl -> Current: open(currentMessage)
ProviderImpl -> Handler: handle(envelope, consumeContext)
Handler --> ProviderImpl: ConsumeDecision
ProviderImpl --> Broker: ack / commit / reconsume
@enduml
