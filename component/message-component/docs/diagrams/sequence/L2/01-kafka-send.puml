@startuml
!include ../../_common/style.puml

title L2：Kafka Provider 发送流程（方法级）

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "DirectMessageSender / DefaultReliableMessageSender" as Sender
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "ProviderSendRequest\nspi" as Request
participant "ProviderSendResult\nspi" as Result
end box
box "Kafka Provider\nmessage-integration-kafka" #FFEBEE
participant "KafkaMessageProvider" as KafkaProvider
participant "KafkaProducer" as KafkaProducer
end box
box "Broker" #FFFDE7
queue "Kafka Topic" as Topic
end box

Sender -> KafkaProvider: send(request)
KafkaProvider -> Request: destination() / messageKey() / headers() / body()
KafkaProvider -> KafkaProducer: send(producerRecord, callback)
KafkaProducer -> Topic: append record
Topic --> KafkaProducer: RecordMetadata / exception
KafkaProducer --> KafkaProvider: callback(metadata, exception)
alt success
  KafkaProvider -> Result: confirmed(providerMessageId, metadata)
else failure
  KafkaProvider -> KafkaProvider: classifySendFailure(exception)
  KafkaProvider -> Result: failed(status, failureType, description, metadata)
end
Result --> KafkaProvider: ProviderSendResult
KafkaProvider --> Sender: CompletionStage<ProviderSendResult>
@enduml
