@startuml
!include ../../_common/style.puml

title L2：RocketMQ4 Provider 基础发送消费（方法级）

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "DirectMessageSender / DefaultReliableMessageSender" as Sender
end box
box "RocketMQ Provider\nmessage-integration-rocketmq" #FFEBEE
participant "RocketMqMessageProvider" as RocketProvider
participant "DefaultMQProducer" as Producer
participant "DefaultMQPushConsumer" as Consumer
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "ProviderSendRequest\nspi" as SendRequest
participant "ProviderSubscriptionRequest\nspi" as SubscribeRequest
participant "ProviderSendResult\nspi" as SendResult
end box
box "Broker" #FFFDE7
queue "RocketMQ4 Broker" as Broker
end box

Sender -> RocketProvider: send(sendRequest)
RocketProvider -> SendRequest: destination() / messageKey() / headers() / body()
RocketProvider -> Producer: send(message, callback)
Producer -> Broker: async send
Broker --> Producer: SendResult / exception
Producer --> RocketProvider: onSuccess(...) / onException(...)
alt SEND_OK
  RocketProvider -> SendResult: confirmed(msgId, metadata)
else non SEND_OK
  RocketProvider -> RocketProvider: classifySendStatus(sendResult)
  RocketProvider -> SendResult: failed(status, failureType, description, metadata)
else exception
  RocketProvider -> RocketProvider: classifySendFailure(throwable)
  RocketProvider -> SendResult: failed(status, failureType, description, metadata)
end
SendResult --> RocketProvider: ProviderSendResult
RocketProvider --> Sender: CompletionStage<ProviderSendResult>

== consume ==
RocketProvider -> RocketProvider: subscribe(subscribeRequest)
RocketProvider -> Consumer: subscribe(topic, tagExpression)
RocketProvider -> Consumer: registerMessageListener(listener)
RocketProvider -> Consumer: start()
Broker -> Consumer: deliver messages
Consumer -> RocketProvider: toInboundMessages(messages)
RocketProvider -> SubscribeRequest: listener().onMessage(inbound)
SubscribeRequest --> RocketProvider: ConsumeDecision
RocketProvider --> Broker: CONSUME_SUCCESS / RECONSUME_LATER
@enduml
