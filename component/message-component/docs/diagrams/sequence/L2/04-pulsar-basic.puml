@startuml
!include ../../_common/style.puml

title L2：Pulsar Provider 基础发送消费（方法级）

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "DirectMessageSender / DefaultReliableMessageSender" as Sender
end box
box "Pulsar Provider\nmessage-integration-pulsar" #FFEBEE
participant "PulsarMessageProvider" as PulsarProvider
participant "PulsarClient" as PulsarClient
participant "Producer<byte[]>" as Producer
participant "Consumer<byte[]>" as Consumer
end box
box "SPI 模块\nmessage-spi" #ECEFF1
participant "ProviderSendRequest\nspi" as SendRequest
participant "ProviderSubscriptionRequest\nspi" as SubscribeRequest
participant "ProviderSendResult\nspi" as SendResult
end box
box "Broker" #FFFDE7
queue "Pulsar Topic" as Topic
end box

Sender -> PulsarProvider: send(sendRequest)
PulsarProvider -> PulsarProvider: producerFor(topic)
PulsarProvider -> Producer: newMessage().key(...).properties(...).value(...).sendAsync()
Producer -> Topic: publish
Topic --> Producer: MessageId / exception
Producer --> PulsarProvider: whenComplete(messageId, throwable)
alt success
  PulsarProvider -> SendResult: confirmed(messageId.toString())
else failure
  PulsarProvider -> PulsarProvider: classifySendFailure(throwable)
  PulsarProvider -> SendResult: failed(status, failureType, description, metadata)
end
SendResult --> PulsarProvider: ProviderSendResult
PulsarProvider --> Sender: CompletionStage<ProviderSendResult>

== consume ==
PulsarProvider -> PulsarProvider: subscribe(subscribeRequest)
PulsarProvider -> PulsarClient: newConsumer()
PulsarClient --> PulsarProvider: Consumer<byte[]>
Topic -> Consumer: message
Consumer -> PulsarProvider: messageListener(...)
PulsarProvider -> SubscribeRequest: listener().onMessage(inbound)
SubscribeRequest --> PulsarProvider: ConsumeDecision
PulsarProvider -> Consumer: acknowledge(message) / negativeAcknowledge(message)
@enduml
