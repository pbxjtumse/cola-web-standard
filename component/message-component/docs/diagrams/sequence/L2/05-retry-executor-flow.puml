@startuml
!include ../../_common/style.puml

title L2：可靠发送与 retry-component 协作（方法级）

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "PreparedMessageSend\ncore.send" as Prepared
participant "DefaultReliableMessageSender\ncore.send.reliability" as ReliableSender
participant "MessageSendRetryClassifier\ncore.send.reliability" as Classifier
end box

box "Retry Component" #FCE4EC
participant "RetryPolicyRegistry" as PolicyRegistry
participant "RetryExecutor" as RetryExecutor
participant "RetryAttempt" as RetryAttempt
participant "RetryResult" as RetryResult
end box

box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSendResult\nspi" as ProviderResult
end box

box "API 模块\nmessage-api" #E3F2FD
participant "SendResult\napi.publish" as SendResult
participant "SendReliabilityInfo\napi.publish" as ReliabilityInfo
end box

Prepared -> ReliableSender: send(prepared)
ReliableSender -> ReliableSender: createRetryId(prepared)
ReliableSender -> PolicyRegistry: getRequired(retryPolicyName)
PolicyRegistry --> ReliableSender: RetryPolicy
ReliableSender -> ReliableSender: createMessageSendPolicy()
ReliableSender -> RetryExecutor: execute(execution)
loop attempt
  RetryExecutor -> ReliableSender: doProviderSendAttempt(prepared)
  ReliableSender -> Provider: send(request)
  Provider --> ReliableSender: ProviderSendResult
  ReliableSender --> RetryExecutor: ProviderSendResult
  RetryExecutor -> RetryAttempt: new RetryAttempt(...)
  RetryExecutor -> Classifier: classify(attempt)
  Classifier -> RetryAttempt: hasFailure() / getResult()
  RetryAttempt --> Classifier: ProviderSendResult
  Classifier -> Classifier: classifyProviderResult(result)
  Classifier --> RetryExecutor: RetryDecision
end
RetryExecutor --> ReliableSender: RetryResult
ReliableSender -> ReliableSender: mapRetryResult(prepared, retryResult)
ReliableSender -> ReliabilityInfo: enabled(...)
ReliableSender -> SendResult: new SendResult(...)
SendResult --> ReliableSender: SendResult
@enduml
