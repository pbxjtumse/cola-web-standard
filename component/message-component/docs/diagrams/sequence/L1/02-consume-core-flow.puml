@startuml
!include ../../_common/style.puml

title L1：消费核心主流程（方法级）

actor Caller as "业务代码"

box "API 模块\nmessage-api" #E3F2FD
participant "MessageConsumerRegistrar\napi.consume" as Registrar
participant "ConsumerDefinition\napi.consume" as Definition
participant "MessageHandler\napi.consume" as Handler
participant "ConsumeDecision\napi.consume" as Decision
end box

box "Core 模块\nmessage-core" #EDE7F6
participant "MessageTemplate\ncore" as Template
participant "DestinationResolver\ncore.routing" as Resolver
participant "MessageProviderRegistry\ncore.provider" as Registry
participant "MessageWireCodec\ncore.codec" as Codec
participant "MessageContextAccessor\ncore.context" as ContextAccessor
participant "CurrentMessage\ncore.context" as Current
end box

box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSubscriptionRequest\nspi" as ProviderRequest
participant "ProviderInboundMessage\nspi" as Inbound
participant "ProviderSubscription\nspi" as ProviderSubscription
end box

Caller -> Registrar: subscribe(definition, handler)
Registrar -> Template: subscribe(definition, handler)
Template -> Resolver: resolve(definition.destination())
Resolver --> Template: ProviderDestination
Template -> Registry: getRequired(providerName)
Registry --> Template: MessageProvider
Template -> Provider: capabilities()
Provider --> Template: BASIC_CONSUME
Template -> ProviderRequest: new ProviderSubscriptionRequest(...)
ProviderRequest --> Template: providerRequest
Template -> Provider: subscribe(providerRequest)
Provider --> Template: ProviderSubscription
Template --> Registrar: MessageSubscription
Registrar --> Caller: MessageSubscription

== inbound callback ==
Provider -> Template: handleInbound(definition, handler, providerDestination, inbound)
Template -> Codec: decode(definition, providerDestination, inbound)
Codec --> Template: DecodedInbound
Template -> Current: new CurrentMessage(envelope, consumeContext)
Template -> ContextAccessor: open(currentMessage)
ContextAccessor --> Template: Scope
Template -> Handler: handle(envelope, consumeContext)
Handler --> Template: ConsumeDecision
Template --> Provider: ConsumeDecision
@enduml
