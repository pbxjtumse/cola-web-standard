@startuml
!include ../../_common/style.puml

title L1：发送核心主流程（二期可靠发送版，方法级）

actor Caller as "业务代码"

box "API 模块\nmessage-api" #E3F2FD
participant "MessagePublisher\napi.publish" as Publisher
participant "MessageDestination\napi.model" as Destination
participant "MessageEnvelope\napi.model" as Envelope
participant "SendOptions\napi.publish" as Options
participant "SendResult\napi.publish" as Result
end box

box "Core 模块\nmessage-core" #EDE7F6
participant "MessageTemplate\ncore" as Template
participant "MessageEnvelopeEnricher\ncore.enrich" as Enricher
participant "MessageIdGenerator\ncore.id" as IdGenerator
participant "DestinationResolver\ncore.routing" as Resolver
participant "MessageProviderRegistry\ncore.provider" as Registry
participant "MessageWireCodec\ncore.codec" as Codec
end box

box "Core Send 模块\nmessage-core.send" #FFF3E0
participant "PreparedMessageSend\ncore.send" as Prepared
participant "MessageSendExecutor\ncore.send" as SendExecutor
participant "DirectMessageSender\ncore.send" as DirectSender
participant "DefaultReliableMessageSender\ncore.send.reliability" as ReliableSender
end box

box "SPI 模块\nmessage-spi" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSendRequest\nspi" as ProviderRequest
participant "ProviderSendResult\nspi" as ProviderResult
end box

Caller -> Publisher: send(destination, envelope, options)
Publisher -> Template: send(destination, envelope, options)
Template -> Template: prepare(destination, message, sendOptions, startedAt)
Template -> Destination: namespace() / name() / providerHint()
Template -> Envelope: metadata() / payload()
Template -> Options: confirmTimeout()
Template -> Enricher: enrich(message)
Enricher -> IdGenerator: nextId()
IdGenerator --> Enricher: messageId
Enricher --> Template: enrichedMessage
Template -> Resolver: resolve(destination)
Resolver --> Template: ProviderDestination
Template -> Registry: getRequired(providerName)
Registry --> Template: MessageProvider
Template -> Provider: capabilities()
Provider --> Template: BASIC_PUBLISH
Template -> Codec: encode(destination, providerDestination, enrichedMessage)
Codec -> ProviderRequest: new ProviderSendRequest(...)
ProviderRequest --> Codec: request
Codec --> Template: ProviderSendRequest
Template -> Prepared: new PreparedMessageSend(...)
Prepared --> Template: prepared
Template -> SendExecutor: send(prepared)

alt reliability.send.enabled = false
  SendExecutor -> DirectSender: send(prepared)
  DirectSender -> Provider: send(request)
  Provider --> DirectSender: CompletionStage<ProviderSendResult>
  DirectSender -> DirectSender: mapProviderResult(...)
  DirectSender --> SendExecutor: SendResult
else reliability.send.enabled = true
  SendExecutor -> ReliableSender: send(prepared)
  ReliableSender -> Provider: send(request) inside retry attempt
  Provider --> ReliableSender: CompletionStage<ProviderSendResult>
  ReliableSender -> ReliableSender: mapRetryResult(...)
  ReliableSender --> SendExecutor: SendResult + SendReliabilityInfo
end

SendExecutor --> Template: SendResult
Template --> Publisher: SendResult
Publisher --> Caller: SendResult

note over Template,SendExecutor
和分布式锁图保持一致：
时序参与者到类级别，箭头展示真实关键方法。
end note
@enduml
