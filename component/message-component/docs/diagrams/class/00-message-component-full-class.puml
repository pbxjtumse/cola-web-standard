@startuml
!include ../_common/style.puml

title Message Component Full Class Diagram - Send + Consume
left to right direction

package "API Model" #E3F2FD {
  class MessageEnvelope
  class MessageMetadata
  class MessageContext
  class MessageHeaders
  class MessageDestination
}

package "API Publish" #E3F2FD {
  interface MessagePublisher
  class SendOptions
  class SendResult
  enum SendStatus
  enum SendStage
  enum SendFailureType
  class SendReliabilityInfo
}

package "API Consume" #E3F2FD {
  interface MessageHandler
  class ConsumeContext
  class ConsumeDecision
  enum ConsumeDecisionType
  enum ConsumeFailureType
  class ConsumerDefinition
  enum ConsumerReliabilityMode
  enum MessageIdempotencyMode
  class MessageIdempotencyOptions
  class MessageConsumeTransactionOptions
}

package "Core Common" #EDE7F6 {
  class MessageTemplate
  class MessageWireCodec
  class MessageEnvelopeEnricher
  class MessageProviderRegistry
  class DefaultDestinationResolver
  class DestinationRouteRegistry
  interface MessageIdGenerator
}

package "Core Send" #FFF3E0 {
  interface MessageSendExecutor
  class DirectMessageSender
  class DefaultReliableMessageSender
  class MessageSendReliabilityOptions
  class PreparedMessageSend
  class MessageSendRetryClassifier
}

package "Core Consume" #FFF3E0 {
  class MessageConsumerAdapter
  class MessageConsumeExecutor
  class MessageHandlerInvoker
  interface IdempotencyStrategy
  class DefaultIdempotencyStrategy
  interface TransactionStrategy
  class DefaultTransactionStrategy
  interface ConsumeExceptionClassifier
  class DefaultConsumeExceptionClassifier
  interface MessageIdempotencyExecutor
  class NoopMessageIdempotencyExecutor
  class DefaultMessageIdempotencyExecutor
  interface MessageIdempotencyKeyResolver
  class DefaultMessageIdempotencyKeyResolver
  interface MessageIdempotencySceneResolver
  class DefaultMessageIdempotencySceneResolver
  class MessageIdempotencyOwnerTokenGenerator
  interface MessageConsumeTransactionExecutor
  class NoopMessageConsumeTransactionExecutor
  class MessageConsumeTransactionContext
  interface MessageIdempotencyContextFactory
  interface MessageIdempotencyStateManager
  class MessageIdempotencyDecisionHandler
  interface MessageIdempotentOperations
}

package "SPI" #ECEFF1 {
  interface MessageProvider
  enum MessageCapability
  class ProviderSendRequest
  class ProviderSendResult
  enum ProviderSendStatus
  interface ProviderMessageListener
  interface ProviderInboundMessage
  interface ProviderMessagePosition
  class ProviderConsumeResult
  class ProviderSubscriptionRequest
  interface ProviderSubscription
}

package "Providers" #FFEBEE {
  class KafkaMessageProvider
  class PulsarMessageProvider
  class RocketMqMessageProvider
  class KafkaProviderInboundMessage
  class PulsarProviderInboundMessage
  class RocketMqProviderInboundMessage
}

package "Starter / Config" #F3E8FF {
  class MessageTemplateAutoConfiguration
  class MessageConsumeAutoConfiguration
  class MessageIdempotencyAutoConfiguration
  class MessageConsumeTransactionAutoConfiguration
  class MessageConsumerDefinitionValidator
  class MessageProperties
  class MessageConsumeProperties
}

package "External Components" #FCE4EC {
  interface RetryExecutor
  interface RetryPolicyRegistry
  interface IdempotentExecutor
  interface TransactionTemplateFacade
}

MessageEnvelope --> MessageMetadata
MessageEnvelope --> MessageContext
MessageEnvelope --> MessageHeaders
MessageEnvelope --> MessageDestination

MessagePublisher <|.. MessageTemplate
MessageTemplate --> MessageEnvelopeEnricher
MessageTemplate --> DefaultDestinationResolver
MessageTemplate --> MessageWireCodec
MessageTemplate --> MessageSendExecutor
MessageTemplate --> MessageConsumerAdapter
MessageTemplate --> MessageProviderRegistry

MessageSendExecutor <|.. DirectMessageSender
MessageSendExecutor <|.. DefaultReliableMessageSender
DirectMessageSender --> MessageProviderRegistry
DirectMessageSender --> MessageProvider
DefaultReliableMessageSender --> RetryExecutor
DefaultReliableMessageSender --> RetryPolicyRegistry
DefaultReliableMessageSender --> MessageSendRetryClassifier
DefaultReliableMessageSender --> MessageProviderRegistry
MessageProvider --> ProviderSendRequest
MessageProvider --> ProviderSendResult
SendResult --> SendReliabilityInfo

MessageConsumerAdapter ..|> ProviderMessageListener
MessageConsumerAdapter --> ConsumerDefinitionRegistry
MessageConsumerAdapter --> MessageWireCodec
MessageConsumerAdapter --> DefaultConsumeContextFactory
MessageConsumerAdapter --> MessageConsumeExecutor
MessageConsumeExecutor --> IdempotencyStrategy
MessageConsumeExecutor --> TransactionStrategy
MessageConsumeExecutor --> MessageHandlerInvoker
MessageHandlerInvoker --> ConsumeExceptionClassifier
IdempotencyStrategy <|.. DefaultIdempotencyStrategy
DefaultIdempotencyStrategy --> MessageIdempotencyExecutor
TransactionStrategy <|.. DefaultTransactionStrategy
ConsumerDefinition --> MessageHandler
ConsumerDefinition --> MessageIdempotencyOptions
ConsumerDefinition --> MessageConsumeTransactionOptions
MessageIdempotencyExecutor <|.. NoopMessageIdempotencyExecutor
MessageIdempotencyExecutor <|.. DefaultMessageIdempotencyExecutor
DefaultMessageIdempotencyExecutor --> MessageIdempotencyContextFactory
DefaultMessageIdempotencyExecutor --> MessageIdempotencyStateManager
DefaultMessageIdempotencyExecutor --> MessageIdempotencyDecisionHandler
MessageIdempotencyDecisionHandler --> MessageIdempotencyStateManager
MessageIdempotencyStateManager --> MessageIdempotentOperations
DefaultTransactionStrategy --> MessageConsumeTransactionExecutor
MessageConsumeTransactionExecutor <|.. NoopMessageConsumeTransactionExecutor
DefaultTransactionStrategy --> MessageConsumeTransactionContext

ProviderMessageListener --> ProviderInboundMessage
ProviderMessageListener --> ProviderConsumeResult
ProviderInboundMessage --> ProviderMessagePosition
ProviderInboundMessage <|.. KafkaProviderInboundMessage
ProviderInboundMessage <|.. PulsarProviderInboundMessage
ProviderInboundMessage <|.. RocketMqProviderInboundMessage
MessageProvider <|.. KafkaMessageProvider
MessageProvider <|.. PulsarMessageProvider
MessageProvider <|.. RocketMqMessageProvider
KafkaMessageProvider --> ProviderConsumeResult : decision.shouldAcknowledge()
PulsarMessageProvider --> ProviderConsumeResult : decision.shouldAcknowledge()
RocketMqMessageProvider --> ProviderConsumeResult : decision.shouldAcknowledge()

MessageTemplateAutoConfiguration --> MessageProperties
MessageConsumeAutoConfiguration --> MessageConsumeProperties
MessageIdempotencyAutoConfiguration --> IdempotentExecutor
MessageConsumeTransactionAutoConfiguration --> TransactionTemplateFacade
MessageConsumerDefinitionValidator --> MessageProviderRegistry
@enduml
