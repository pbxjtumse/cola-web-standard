@startuml
!include _common/style.puml

title 二期发送可靠性总览图（方法级入口）

actor Caller as "业务代码"

box "Core\nmessage-core" #EDE7F6
participant "MessageTemplate\ncore" as Template
end box
box "Core Send\nmessage-core.send" #FFF3E0
participant "PreparedMessageSend\ncore.send" as Prepared
participant "DefaultReliableMessageSender\ncore.send.reliability" as ReliableSender
participant "MessageSendRetryClassifier\ncore.send.reliability" as Classifier
end box
box "Retry Component" #FCE4EC
participant "RetryExecutor" as RetryExecutor
participant "RetryResult" as RetryResult
end box
box "SPI / Provider" #ECEFF1
participant "MessageProvider\nspi" as Provider
participant "ProviderSendResult\nspi" as ProviderResult
end box
box "Broker" #FFFDE7
queue "Kafka / Pulsar / RocketMQ4" as Broker
end box

Caller -> Template: send(destination, envelope, options)
Template -> Template: prepare(...)
Template -> Prepared: new PreparedMessageSend(...)
Template -> ReliableSender: send(prepared)
ReliableSender -> RetryExecutor: execute(execution)
RetryExecutor -> ReliableSender: doProviderSendAttempt(prepared)
ReliableSender -> Provider: send(request)
Provider -> Broker: native send
Broker --> Provider: ack / timeout / native error
Provider --> ReliableSender: ProviderSendResult
ReliableSender -> Classifier: classify(attempt)
Classifier --> RetryExecutor: RetryDecision
RetryExecutor --> ReliableSender: RetryResult
ReliableSender -> ReliableSender: mapRetryResult(prepared, retryResult)
ReliableSender --> Template: SendResult + SendReliabilityInfo
Template --> Caller: SendResult
@enduml
