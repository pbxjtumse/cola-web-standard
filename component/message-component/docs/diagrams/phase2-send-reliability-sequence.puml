@startuml
!include _common/style.puml
title message-component 二期可靠发送总览图

actor Biz as "业务代码"
participant "MessageTemplate" as Template
participant "prepare()\nvalidate/enrich/resolve/serialize" as Prepare
participant "PreparedMessageSend" as Prepared
participant "MessageSendExecutor" as Executor
participant "DefaultReliableMessageSender" as Sender
participant "RetryExecutor\n(retry-component)" as Retry
participant "MessageSendRetryClassifier" as Classifier
participant "MessageProvider\nKafka/Pulsar/RocketMQ4" as Provider
queue Broker
participant "SendResult" as Result

Biz -> Template: send(destination, envelope)
Template -> Prepare: prepare send

alt preparation failed
  Prepare --> Template: PreparationException(stage, failureType)
  Template -> Result: REJECTED / FAILED
  Result --> Biz: SendResult
else preparation succeeded
  Prepare --> Template: PreparedMessageSend
  Template -> Executor: send(prepared)
  Executor -> Sender: send(prepared)
  Sender -> Retry: execute(message-send)

  loop retry attempts
    Retry -> Sender: attempt
    Sender -> Provider: provider.send(request)
    Provider -> Broker: native publish
    Broker --> Provider: ack / reject / error / timeout
    Provider --> Sender: ProviderSendResult
    Retry -> Classifier: classify(result)
    Classifier --> Retry: SUCCESS / RETRY / STOP / ABORT
  end

  Retry --> Sender: RetryResult
  Sender -> Result: map to SendResult + SendReliabilityInfo
  Result --> Template: SendResult
  Template --> Biz: SendResult
end

note over Classifier
UNKNOWN 默认 STOP，不继续重试。
RETRY_EXHAUSTED 是 failureType，不是 SendStatus。
end note
@enduml
