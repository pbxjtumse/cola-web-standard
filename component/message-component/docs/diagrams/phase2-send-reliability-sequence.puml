@startuml
' message-component phase2 reliable send sequence
hide footbox
title message-component 二期可靠发送时序图

actor Biz as "业务代码"
participant Template as "MessageTemplate"
participant Prepare as "prepare()"
participant Sender as "DefaultReliableMessageSender"
participant Retry as "RetryExecutor\n(retry-component)"
participant Classifier as "MessageSendRetryClassifier"
participant Provider as "MessageProvider\nKafka/Pulsar/RocketMQ4"
participant Broker as "Broker"
participant Result as "SendResult"

Biz -> Template : send(destination, envelope)
Template -> Prepare : validate / enrich / route / serialize

alt 准备阶段失败
    Prepare --> Template : PreparationException(stage, failureType)
    Template -> Result : SendResult(REJECTED/FAILED)
    Result --> Biz : 标准失败结果
else 准备成功
    Prepare --> Template : PreparedMessageSend
    Template -> Sender : send(prepared)
    Sender -> Retry : execute(RetryExecution<ProviderSendResult>)

    loop attempt <= maxAttempts && within maxDuration
        Retry -> Sender : execute attempt
        Sender -> Provider : provider.send(request)
        Provider -> Broker : 写入或提交发送请求

        alt Broker 明确确认
            Broker --> Provider : ack / providerMessageId
            Provider --> Sender : ProviderSendResult(CONFIRMED)
            Retry -> Classifier : classify(CONFIRMED)
            Classifier --> Retry : RetryDecision.SUCCESS
            Retry --> Sender : RetryResult.SUCCESS
            Sender -> Result : SendResult(CONFIRMED, reliabilityInfo)
            Result --> Template : confirmed result
            Template --> Biz : SendResult.CONFIRMED
        else 明确可重试失败
            Provider --> Sender : ProviderSendResult(FAILED, NETWORK_ERROR/CLIENT_ERROR)
            Retry -> Classifier : classify(FAILED)
            Classifier --> Retry : RetryDecision.RETRY
            Retry -> Retry : backoff
        else 明确不可重试失败
            Provider --> Sender : ProviderSendResult(REJECTED/FAILED, non-retryable)
            Retry -> Classifier : classify(non-retryable)
            Classifier --> Retry : RetryDecision.STOP
            Retry --> Sender : RetryResult.NOT_RETRYABLE
            Sender -> Result : SendResult(REJECTED/FAILED, reliabilityInfo)
            Result --> Template : stopped result
            Template --> Biz : SendResult
        else 确认超时或结果未知
            Broker --x Provider : ack 丢失或响应超时
            Provider --> Sender : UNKNOWN/TIMEOUT
            Retry -> Classifier : classify(UNKNOWN)
            alt retryWhenUnknown=false
                Classifier --> Retry : STOP，避免重复消息
                Retry --> Sender : RetryResult.NOT_RETRYABLE
                Sender -> Result : SendResult.UNKNOWN
                Result --> Template : unknown result
                Template --> Biz : SendResult.UNKNOWN
            else retryWhenUnknown=true
                Classifier --> Retry : RETRY，显式接受重复风险
                Retry -> Retry : backoff
            end
        end
    end

    alt 重试耗尽
        Retry --> Sender : RetryResult.EXHAUSTED
        alt last result = UNKNOWN
            Sender -> Result : SendResult(UNKNOWN, RETRY_EXHAUSTED)
        else last result = FAILED
            Sender -> Result : SendResult(FAILED, RETRY_EXHAUSTED)
        end
        Result --> Template : exhausted result
        Template --> Biz : SendResult
    end
end
@enduml
