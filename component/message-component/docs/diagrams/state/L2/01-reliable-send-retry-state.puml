@startuml
!include ../../_common/style.puml

title L2：可靠发送重试状态图

[*] --> READY
state "READY\n待发送上下文已准备" as READY
state "ATTEMPT\n一次 Provider 发送" as ATTEMPT
state "CLASSIFY\n重试分类" as CLASSIFY
state "BACKOFF\n等待下一次尝试" as BACKOFF
state "CONFIRMED" as CONFIRMED
state "FAILED" as FAILED
state "UNKNOWN" as UNKNOWN
state "REJECTED" as REJECTED

READY --> ATTEMPT
ATTEMPT --> CLASSIFY
CLASSIFY --> CONFIRMED : SUCCESS
CLASSIFY --> BACKOFF : RETRY
BACKOFF --> ATTEMPT : next attempt
CLASSIFY --> UNKNOWN : STOP with UNKNOWN
CLASSIFY --> FAILED : STOP with FAILED
CLASSIFY --> REJECTED : STOP with REJECTED
BACKOFF --> FAILED : exhausted and last FAILED
BACKOFF --> UNKNOWN : exhausted and last UNKNOWN
CONFIRMED --> [*]
FAILED --> [*]
UNKNOWN --> [*]
REJECTED --> [*]
@enduml
