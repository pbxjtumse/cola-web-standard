@startuml
!include ../../_common/style.puml

title L3：RetryResult 到 SendResult 映射状态图

state "RetryResult" as RETRY #FCE4EC
state "CONFIRMED\nSendStatus.CONFIRMED" as CONFIRMED
state "FAILED\nSendStatus.FAILED" as FAILED
state "UNKNOWN\nSendStatus.UNKNOWN" as UNKNOWN
state "REJECTED\nSendStatus.REJECTED" as REJECTED

[*] --> RETRY
RETRY --> CONFIRMED : SUCCESS
RETRY --> FAILED : EXHAUSTED + last FAILED
RETRY --> UNKNOWN : EXHAUSTED + last UNKNOWN
RETRY --> UNKNOWN : TIMED_OUT / INTERRUPTED
RETRY --> FAILED : EXECUTION_FAILED / ABORTED / CANCELLED
RETRY --> REJECTED : NOT_RETRYABLE + original REJECTED
RETRY --> FAILED : NOT_RETRYABLE + original FAILED
RETRY --> UNKNOWN : NOT_RETRYABLE + original UNKNOWN
CONFIRMED --> [*]
FAILED --> [*]
UNKNOWN --> [*]
REJECTED --> [*]
@enduml
