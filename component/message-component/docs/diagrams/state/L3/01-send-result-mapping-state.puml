@startuml
!include ../../_common/style.puml
title State L3：RetryStatus 到 SendResult 映射状态图
hide empty description

[*] --> RETRY_STATUS

RETRY_STATUS --> SEND_CONFIRMED : SUCCESS
RETRY_STATUS --> CHECK_EXHAUSTED_LAST : EXHAUSTED
RETRY_STATUS --> USE_PROVIDER_ORIGINAL : NOT_RETRYABLE
RETRY_STATUS --> SEND_UNKNOWN_TIMEOUT : TIMED_OUT
RETRY_STATUS --> SEND_UNKNOWN_INTERRUPTED : INTERRUPTED
RETRY_STATUS --> SEND_FAILED_RETRY_ERROR : CANCELLED / ABORTED / EXECUTION_FAILED

CHECK_EXHAUSTED_LAST --> SEND_UNKNOWN_RETRY_EXHAUSTED : last ProviderSendResult = UNKNOWN
CHECK_EXHAUSTED_LAST --> SEND_FAILED_RETRY_EXHAUSTED : last ProviderSendResult = FAILED or null

USE_PROVIDER_ORIGINAL --> SEND_REJECTED : original = REJECTED
USE_PROVIDER_ORIGINAL --> SEND_FAILED : original = FAILED
USE_PROVIDER_ORIGINAL --> SEND_UNKNOWN : original = UNKNOWN

SEND_CONFIRMED --> [*]
SEND_REJECTED --> [*]
SEND_FAILED --> [*]
SEND_UNKNOWN --> [*]
SEND_UNKNOWN_TIMEOUT --> [*]
SEND_UNKNOWN_INTERRUPTED --> [*]
SEND_UNKNOWN_RETRY_EXHAUSTED --> [*]
SEND_FAILED_RETRY_EXHAUSTED --> [*]
SEND_FAILED_RETRY_ERROR --> [*]
@enduml
